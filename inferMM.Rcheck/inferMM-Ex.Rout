> one_curve <- subset(sdl_demo, enzyme == "1111")
> 
> fit <- fit_mm(
+   x = one_curve$s_uM,
+   y = one_curve$v_uM_per_min,
+   variance = "sqrt"
+ )
> 
> fit_power <- fit_mm(
+   x = one_curve$s_uM,
+   y = one_curve$v_uM_per_min,
+   variance = "power",
+   power = 0.4
+ )
> 
> fit_auto <- fit_mm(
+   x = one_curve$s_uM,
+   y = one_curve$v_uM_per_min,
+   variance = "auto",
+   power_selection = "quasi_aic"
+ )
